        <mxCell id="activate" parent="cutoverLane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;strokeWidth=2;" value="4  Activate Azure production&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Authorize West Europe origins&lt;br&gt;shift traffic gradually • monitor every journey&lt;/font&gt;" vertex="1">

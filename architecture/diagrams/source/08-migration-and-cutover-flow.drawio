  <diagram id="migration-cutover" name="Migration and Cutover Flow">
    <mxGraphModel dx="2175" dy="1306" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">

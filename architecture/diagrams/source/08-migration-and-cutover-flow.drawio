        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontColor=#5B6573;" value="Phased re-platform • two production-like rehearsals • human-authorized go/no-go • controlled rollback • protected source retention" vertex="1">

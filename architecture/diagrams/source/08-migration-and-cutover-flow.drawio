        <mxCell id="preWindow" parent="cutoverLane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" value="1  Prepare change window&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Confirm owners, health, backups and rollback&lt;br&gt;reduce DNS TTL • freeze releases • notify parties&lt;/font&gt;" vertex="1">

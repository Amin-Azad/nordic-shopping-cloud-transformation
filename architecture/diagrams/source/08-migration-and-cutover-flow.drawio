        <mxCell id="prepareLane" parent="1" style="swimlane;html=1;rounded=1;startSize=38;horizontal=1;fillColor=#F8FBFF;swimlaneFillColor=#D9EAF7;strokeColor=#6C8EBF;fontColor=#17365D;fontStyle=1;fontSize=14;" value="1  DISCOVER AND BUILD" vertex="1">

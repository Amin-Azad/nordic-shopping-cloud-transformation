        <mxCell id="acceptGate" parent="cutoverLane" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" value="ACCEPT?&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Business journeys stable&lt;br&gt;data and provider totals agree&lt;br&gt;controls and operations&amp;nbsp;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size:11px&quot;&gt;healthy&lt;/font&gt;&lt;/div&gt;" vertex="1">

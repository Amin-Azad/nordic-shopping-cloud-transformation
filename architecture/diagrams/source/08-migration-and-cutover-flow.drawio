        <mxCell id="goNoGo" parent="proveLane" style="rhombus;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;strokeWidth=2;" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;GO / NO-GO&lt;br&gt;&lt;font style=&quot;&quot;&gt;Named Business, Project, App,&amp;nbsp;&lt;/font&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;font style=&quot;&quot;&gt;Data, Security and Operations&lt;/font&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;font style=&quot;&quot;&gt;&amp;nbsp;approval&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">

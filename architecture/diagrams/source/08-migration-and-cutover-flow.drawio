        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=26;fontStyle=1;fontColor=#17365D;" value="Nordic Shopping — Migration and Production Cutover Flow" vertex="1">

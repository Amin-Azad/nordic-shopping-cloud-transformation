        </mxCell>
        <mxCell id="discover" parent="prepareLane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" value="Discover and assess&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Inventory • dependencies • data • identity&lt;br&gt;DNS • providers • baseline • compliance&lt;/font&gt;" vertex="1">

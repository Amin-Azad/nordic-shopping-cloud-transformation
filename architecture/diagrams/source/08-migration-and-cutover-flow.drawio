        </mxCell>
        <mxCell id="rehearsal1" parent="proveLane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" value="Rehearsal 1 — procedure validation&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Production-like copy • scripts • access • timing&lt;br&gt;reconciliation • technical rollback • defect log&lt;/font&gt;" vertex="1">
